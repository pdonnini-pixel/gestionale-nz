<?xml version="1.0" encoding="utf-8"?>
<!-- Pacchetto privacy (12/11/2026): i dati dell'app (segreto del QR, sessione,
     giornata di oggi) non vanno nel backup di Google né nel trasferimento a un
     altro telefono. Sul telefono nuovo si riattiva l'app con un codice. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
